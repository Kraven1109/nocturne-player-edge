{
  "name": "nocturne-player-edge",
  "version": "0.10.0",
  "private": true,
  "description": "A touch-first video player for Microsoft Edge and Chromium browsers (port of Nocturne Player)",
  "license": "MPL-2.0",
  "author": "Vlad Pohorilets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kraven1109/nocturne-player-edge.git"
  },
  "homepage": "https://github.com/Kraven1109/nocturne-player-edge",
  "bugs": {
    "url": "https://github.com/Kraven1109/nocturne-player-edge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:clean": "node esbuild.config.mjs --clean",
    "package": "npm run build && node -e \"require('fs').mkdirSync('artifacts',{recursive:true})\" && cd dist && python3 -m zipfile -c ../artifacts/nocturne-edge.zip .",
    "start": "npm run build && microsoft-edge-stable --user-data-dir=$(mktemp -d /tmp/edge-nocturne-XXXXXX) --load-extension=./dist",
    "lint": "eslint . && prettier --check \"**/*.{js,mjs,json,md,css,html}\" && npm run lint:privacy",
    "lint:privacy": "node tools/check-privacy.mjs",
    "validate:mv3": "node tools/validate-mv3.mjs",
    "icons": "node tools/render-icons.mjs",
    "fix": "eslint . --fix && prettier --write \"**/*.{js,mjs,json,md,css,html}\"",
    "test": "node --test test/unit",
    "test:e2e": "node test/e2e/chapters-spa.mjs",
    "fixture": "node tools/make-fixture.mjs",
    "serve": "node tools/serve.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ],
    "src/**": [
      "node tools/check-privacy.mjs"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-metarhia": "10.0.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright-core": "^1.65.0",
    "prettier": "3.10.1",
    "web-ext": "10.8.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
